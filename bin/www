#!/usr/bin/env node

/**
 * Module dependencies.
 */

var path = require('path');
var envResult = require('dotenv').config({ path: path.join(__dirname, '..', '.env') });
if (envResult.error && envResult.error.code !== 'ENOENT') {
  throw envResult.error;
}

var app = require('../app');
var debug = require('debug')('tobuy-server:server');
var http = require('http');
var attachWebSocketServer = require('../services/tobuy-websocket');
var createKeepClient = require('../services/keep-client');
var createKeepSync = require('../services/keep-sync');

['KEEP_EMAIL', 'KEEP_MASTER_TOKEN', 'KEEP_NOTE_ID'].forEach(function(name) {
  if (!process.env[name]) {
    throw new Error(name + ' must be configured');
  }
});
var interval = Number(process.env.KEEP_POLL_INTERVAL_MS || '30000');
if (!Number.isSafeInteger(interval) || interval < 1000 || interval > 2147483647) {
  throw new Error('KEEP_POLL_INTERVAL_MS must be an integer between 1000 and 2147483647');
}
var python = process.env.KEEP_PYTHON || path.join(__dirname, '..', '.venv', 'bin', 'python');
if (python.includes('/')) {
  python = path.resolve(__dirname, '..', python);
}
var keepClient = createKeepClient(python, process.env);
var keepSync = createKeepSync(app.locals.tobuyStore, keepClient);
var pollTimer;
var pollPending = false;
var shuttingDown = false;

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);
var webSocketServer = attachWebSocketServer(server, app.locals.tobuyStore, keepSync.setPeriodic);

/**
 * Listen on provided port, on all network interfaces.
 */

server.on('error', onError);
server.on('listening', onListening);
server.on('close', function() {
  clearInterval(pollTimer);
  keepClient.close();
});

function refreshKeep() {
  if (pollPending || shuttingDown) {
    return;
  }
  pollPending = true;
  keepSync.refresh().catch(function(error) {
    if (!shuttingDown) {
      console.error('Google Keep sync failed:', error.message);
    }
  }).finally(function() {
    pollPending = false;
  });
}

server.listen(port);
refreshKeep();
pollTimer = setInterval(refreshKeep, interval);

['SIGINT', 'SIGTERM'].forEach(function(signal) {
  process.on(signal, function() {
    shuttingDown = true;
    clearInterval(pollTimer);
    keepClient.close();
    webSocketServer.clients.forEach(function(client) { client.terminate(); });
    webSocketServer.close();
    if (server.listening) {
      server.close();
    } else {
      process.exitCode = 0;
    }
  });
});

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
